<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Properties>
        <!-- Define reusable properties -->
        <Property name="LOG_PATTERN">%d{HH:mm:ss,SSS} [%-5p] %c{1.} - %m%n</Property>
        <Property name="LOG_BASE_PATH">${sys:user.home}/Solor/komet/logs</Property>
        <Property name="FILE_SIZE_LIMIT">100MB</Property>
        <Property name="LOG_RETENTION_DAYS">P30D</Property>
    </Properties>

    <Appenders>
        <Console name="console" target="SYSTEM_OUT">
            <PatternLayout pattern="${LOG_PATTERN}"/>
        </Console>

        <RollingFile name="rollingFile"
                     filePattern="${LOG_BASE_PATH}/%d{ISO8601_BASIC}.log"
                     ignoreExceptions="false">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <DirectWriteRolloverStrategy>
                <Delete basePath="${LOG_BASE_PATH}" maxDepth="1">
                    <IfLastModified age="${LOG_RETENTION_DAYS}"/>
                </Delete>
            </DirectWriteRolloverStrategy>
            <Policies>
                <SizeBasedTriggeringPolicy size="${FILE_SIZE_LIMIT}"/>
                <OnStartupTriggeringPolicy minSize="0"/>
            </Policies>
        </RollingFile>

        <!-- Dedicated ChangeSetWriterProvider RollingFileAppender -->
        <RollingFile name="changeSetWriterFile"
                     filePattern="${LOG_BASE_PATH}/%d{ISO8601_BASIC}-changeset-writer.log"
                     ignoreExceptions="false">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <DirectWriteRolloverStrategy>
                <Delete basePath="${LOG_BASE_PATH}" maxDepth="1">
                    <IfFileName glob="*-changeset-writer.log">
                        <IfLastModified age="${LOG_RETENTION_DAYS}"/>
                    </IfFileName>
                </Delete>
            </DirectWriteRolloverStrategy>
            <Policies>
                <SizeBasedTriggeringPolicy size="${FILE_SIZE_LIMIT}"/>
                <OnStartupTriggeringPolicy minSize="0"/>
            </Policies>
        </RollingFile>

        <!-- Dedicated rule-engine RollingFileAppender: Evrete (JUL, bridged via
             log4j-jul) + IKE rule classes. See IKE-Network/ike-issues#627. -->
        <RollingFile name="rulesFile"
                     filePattern="${LOG_BASE_PATH}/%d{ISO8601_BASIC}-rules.log"
                     ignoreExceptions="false">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <DirectWriteRolloverStrategy>
                <Delete basePath="${LOG_BASE_PATH}" maxDepth="1">
                    <IfFileName glob="*-rules.log">
                        <IfLastModified age="${LOG_RETENTION_DAYS}"/>
                    </IfFileName>
                </Delete>
            </DirectWriteRolloverStrategy>
            <Policies>
                <SizeBasedTriggeringPolicy size="${FILE_SIZE_LIMIT}"/>
                <OnStartupTriggeringPolicy minSize="0"/>
            </Policies>
        </RollingFile>
    </Appenders>

    <Loggers>
        <Root level="INFO">
            <AppenderRef ref="console"/>
            <AppenderRef ref="rollingFile"/>
        </Root>

        <!-- Reasoner tracking - INFO level shows key events only -->
        <Logger name="dev.ikm.komet.framework.EditedConceptTracker" level="INFO" additivity="false">
            <AppenderRef ref="console"/>
            <AppenderRef ref="rollingFile"/>
        </Logger>
        
        <Logger name="dev.ikm.komet.reasoner.ui" level="INFO" additivity="false">
            <AppenderRef ref="console"/>
            <AppenderRef ref="rollingFile"/>
        </Logger>

        <!-- Reduce noise from verbose providers -->
        <Logger name="dev.ikm.tinkar.provider.entity.EntityProvider" level="WARN" additivity="false">
            <AppenderRef ref="console"/>
            <AppenderRef ref="rollingFile"/>
        </Logger>
        
        <Logger name="dev.ikm.tinkar.provider.changeset.ChangeSetWriterProvider" level="WARN" additivity="false">
            <AppenderRef ref="console"/>
            <AppenderRef ref="rollingFile"/>
        </Logger>

        <!-- RocksProvider logs one INFO line per nidForUuids lookup, which floods
             the log during bulk operations (e.g. journal window restoration). -->
        <Logger name="dev.ikm.ds.rocks.RocksProvider" level="WARN" additivity="false">
            <AppenderRef ref="console"/>
            <AppenderRef ref="rollingFile"/>
        </Logger>

        <!-- Rule engine → dedicated -rules.log. org.evrete is the Evrete engine
             (JUL, bridged via log4j-jul); dev.ikm.komet.rules is the IKE rule code
             (slf4j). additivity="false" keeps them out of the main rolling log.
             See IKE-Network/ike-issues#627. -->
        <Logger name="org.evrete" level="INFO" additivity="false">
            <AppenderRef ref="console"/>
            <AppenderRef ref="rulesFile"/>
        </Logger>

        <Logger name="dev.ikm.komet.rules" level="INFO" additivity="false">
            <AppenderRef ref="console"/>
            <AppenderRef ref="rulesFile"/>
        </Logger>
    </Loggers>
</Configuration>
